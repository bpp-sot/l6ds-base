{
  "name": "L6 Data Science",

  // Prebuilt image (Python 3.12 + data-science stack + NLTK data), published
  // from this repo by .github/workflows/publish-images.yml.
  "image": "ghcr.io/bpp-sot/l6ds-base:latest",

  // To build locally from the Dockerfile instead, replace "image" with:
  // "build": {
  //   "dockerfile": "Dockerfile",
  //   "context": "..",
  //   "target": "base"
  // },

  "remoteUser": "vscode",

  // Quick no-op for the pre-installed packages; picks up anything you add to
  // requirements.txt for your own project.
  "postCreateCommand": "pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.black-formatter",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "notebook.formatOnSave.enabled": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },
  "forwardPorts": [8888]
}
